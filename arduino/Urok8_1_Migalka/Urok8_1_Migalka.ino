/*
  Урок 8. Задание 1 — «Мигалка»

  Собираем схему: пищалка + красный и синий светодиоды.
  Светодиоды мигают по очереди, как маячки полицейской машины.
  При включении пищалка коротко пикает — так проверяем,
  что она подключена правильно.

  Подключение (резистор — со стороны плюса):
    пин 7 → резистор 220 Ом → красный светодиод (длинная ножка +)
    пин 6 → резистор 220 Ом → синий светодиод (длинная ножка +)
    короткие ножки (−) светодиодов → GND
    пищалка «+» → пин 8, пищалка «−» → GND
*/

// Даём пинам понятные имена: так код легче читать и менять
const int RED_LED  = 7;    // красный светодиод
const int BLUE_LED = 6;    // синий светодиод
const int BUZZER   = 8;    // пищалка

const int BLINK_TIME = 300;   // сколько мс горит каждый цвет

void setup() {
  // Все три устройства — выходы: Arduino ими управляет
  pinMode(RED_LED, OUTPUT);
  pinMode(BLUE_LED, OUTPUT);
  pinMode(BUZZER, OUTPUT);

  // Проверка пищалки: короткий писк при включении
  tone(BUZZER, 1000);   // звук частотой 1000 Гц
  delay(200);           // звучит 0,2 секунды
  noTone(BUZZER);       // выключаем звук
}

void loop() {
  // Фаза 1: красный горит, синий погашен
  digitalWrite(RED_LED, HIGH);
  digitalWrite(BLUE_LED, LOW);
  delay(BLINK_TIME);

  // Фаза 2: синий горит, красный погашен
  digitalWrite(RED_LED, LOW);
  digitalWrite(BLUE_LED, HIGH);
  delay(BLINK_TIME);
}
