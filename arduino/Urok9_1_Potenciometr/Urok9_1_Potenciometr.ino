/*
  Урок 9. Задание 1 — читаем потенциометр

  Потенциометр — это делитель напряжения. Крутим ручку —
  напряжение на среднем выводе меняется от 0 до 5 вольт.
  Arduino измеряет его и превращает в число от 0 до 1023.

  Подключение:
    левый вывод потенциометра  → GND
    средний вывод (движок)     → A0
    правый вывод               → 5V

  После загрузки откройте «Монитор порта» (Serial Monitor)
  и выберите скорость 9600 бод.
*/

const int POT = A0;   // потенциометр на аналоговом входе A0

void setup() {
  Serial.begin(9600);   // связь с компьютером, 9600 бод
  // pinMode для analogRead писать не нужно
}

void loop() {
  int value = analogRead(POT);            // число от 0 до 1023
  float voltage = value * 5.0 / 1023.0;   // переводим в вольты

  Serial.print("Значение: ");
  Serial.print(value);
  Serial.print("   Напряжение: ");
  Serial.print(voltage);       // float: 2 знака после точки
  Serial.println(" В");

  delay(200);   // 5 измерений в секунду — успеваем читать
}
