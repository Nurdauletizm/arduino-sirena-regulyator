/*
  Урок 9. Задание 2, вариант Б — самый простой

  Пауза в миллисекундах просто равна числу с потенциометра
  (0…1023 мс). Это и есть «пропорционально»: повернули ручку
  в 2 раза дальше — пауза стала в 2 раза длиннее.

  Минус: около нуля светодиод мигает так быстро, что глаз
  не успевает — кажется, будто он просто горит.
*/

const int POT = A0;   // потенциометр
const int LED = 7;    // светодиод

void setup() {
  pinMode(LED, OUTPUT);
}

void loop() {
  int value = analogRead(POT);   // 0…1023
  digitalWrite(LED, HIGH);
  delay(value);                  // пауза = значение, мс
  digitalWrite(LED, LOW);
  delay(value);
}
