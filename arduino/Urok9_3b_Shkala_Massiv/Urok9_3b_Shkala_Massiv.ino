/*
  Урок 9. Задание 3, вариант Б — шкала с массивом и циклом

  То же самое, но короче. Пины светодиодов храним в МАССИВЕ,
  а функция map() сразу считает, сколько светодиодов зажечь.
  Так легко сделать шкалу хоть из 10 светодиодов.

  Схема та же, что в задании 3.
*/

const int POT = A0;                  // потенциометр
const int LEDS[4] = {7, 6, 5, 4};    // пины: от первого к четвёртому

void setup() {
  for (int i = 0; i < 4; i++) {
    pinMode(LEDS[i], OUTPUT);        // каждый пин из массива — выход
  }
}

void loop() {
  int value = analogRead(POT);             // 0…1023
  int level = map(value, 0, 1023, 0, 5);   // 5 зон: 0, 1, 2, 3, 4
  // (level = 5 бывает только при 1023 — тогда тоже горят все)

  for (int i = 0; i < 4; i++) {
    if (i < level) {
      digitalWrite(LEDS[i], HIGH);   // «ниже уровня» — горит
    } else {
      digitalWrite(LEDS[i], LOW);    // остальные погашены
    }
  }

  delay(50);
}
